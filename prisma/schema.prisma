generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  COACH
  STUDENT
  PARENT
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum StudentStatus {
  ACTIVE
  INACTIVE
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum SkillLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  PROFESSIONAL
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LEAVE
  LATE
  EXCUSED
}

enum FeeStatus {
  PAID
  PARTIAL
  PENDING
  OVERDUE
  WAIVED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  JAZZCASH
  EASYPAISA
  CARD
  OTHER
}

enum MatchResult {
  WON
  LOST
  DRAW
  TIE
}

enum MatchType {
  FRIENDLY
  TOURNAMENT
  LEAGUE
  PRACTICE
  OTHER
}

enum Dismissal {
  BOWLED
  CAUGHT
  LBW
  RUN_OUT
  STUMPED
  NOT_OUT
  RETIRED
  OTHER
}

enum GoalStatus {
  NOT_STARTED
  IN_PROGRESS
  ACHIEVED
  CANCELLED
}

enum TrainingCategory {
  BATTING
  BOWLING
  FIELDING
  FITNESS
  WICKETKEEPING
  TACTICAL
  MATCH_PRACTICE
}

enum AdmissionStatus {
  NEW
  REVIEW
  APPROVED
  REJECTED
  CONVERTED
}

enum ExpenseCategory {
  EQUIPMENT
  GROUND
  TRANSPORT
  UTILITIES
  SALARIES
  MAINTENANCE
  EVENTS
  OTHER
}

enum BillingType {
  MONTHLY
  QUARTERLY
  HALF_YEARLY
  YEARLY
}

enum AnnouncementPriority {
  LOW
  MEDIUM
  HIGH
}

enum ActivityType {
  LOGIN
  LOGOUT
  PASSWORD_RESET
  STUDENT_CREATED
  STUDENT_UPDATED
  STUDENT_DEACTIVATED
  STUDENT_ACTIVATED
  STUDENT_DELETED
  ATTENDANCE_MARKED
  FEE_RECORDED
  FEE_UPDATED
  RECEIPT_GENERATED
  PERFORMANCE_ADDED
  PERFORMANCE_UPDATED
  GOAL_ADDED
  GOAL_UPDATED
  MATCH_ADDED
  MATCH_UPDATED
  TRAINING_SESSION_CREATED
  TRAINING_ATTENDANCE_RECORDED
  ADMISSION_SUBMITTED
  ADMISSION_REVIEWED
  EXPENSE_ADDED
  EXPENSE_UPDATED
  EXPENSE_DELETED
  PACKAGE_CREATED
  PACKAGE_UPDATED
  PACKAGE_DELETED
  COACH_ADDED
  COACH_UPDATED
  COACH_DEACTIVATED
  ANNOUNCEMENT_CREATED
  SETTINGS_UPDATED
  BACKUP_EXPORTED
  BACKUP_RESTORED
  NOTIFICATION_SENT
  OTHER
}

model User {
  id             String          @id @default(cuid())
  email          String          @unique
  passwordHash   String
  fullName       String
  mobile         String?         @unique
  role           Role            @default(STUDENT)
  status         UserStatus      @default(ACTIVE)
  photoUrl       String?
  studentId      String?
  sessionVersion Int             @default(0)
  lastLoginAt    DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  createdBy      String?
  updatedBy      String?

  coachProfile     CoachProfile?
  parentLinks      StudentParent[]
  coachStudents    Student[]         @relation("StudentCoach")
  batches          Batch[]
  performances     Performance[]
  matches          Match[]
  goals            Goal[]
  trainingSessions TrainingSession[]
  activities       Activity[]
  notifications    Notification[]
  resetTokens      PasswordResetToken[]
  pushSubscriptions PushSubscription[]
  uploadedDocuments Document[]      @relation("DocumentUploader")

  @@index([role, status])
  @@index([studentId])
}

model Batch {
  id               String    @id @default(cuid())
  name             String    @unique
  description      String?
  coachId          String?
  coach            User?     @relation(fields: [coachId], references: [id])
  ageGroup         String?
  trainingDays     String?
  trainingTime     String?
  trainingLocation String?
  capacity         Int       @default(0)
  isActive         Boolean   @default(true)
  students         Student[]
  sessions         TrainingSession[]
  admissions       Admission[]
  announcements    Announcement[]
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([coachId])
}

model Student {
  id               String        @id @default(cuid())
  studentId        String        @unique
  fullName         String
  guardianName     String
  mobile           String
  whatsapp         String?
  dob              DateTime      @db.Date
  gender           Gender
  address          String?
  joinDate         DateTime      @db.Date
  batchId          String?
  batch            Batch?        @relation(fields: [batchId], references: [id])
  skillLevel       SkillLevel    @default(BEGINNER)
  monthlyFee       Int           @default(0)
  emergencyContact String?
  bloodGroup       String?
  photoUrl         String?
  status           StudentStatus @default(ACTIVE)
  email            String?
  playingRole      String?
  battingStyle     String?
  bowlingStyle     String?
  jerseyNumber     Int?
  preferredPosition String?
  coachId          String?
  coach            User?         @relation("StudentCoach", fields: [coachId], references: [id])
  qrToken          String        @unique
  deletedAt        DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  createdBy        String?
  updatedBy        String?

  parentLinks  StudentParent[]
  attendance   Attendance[]
  fees         Fee[]
  performances Performance[]
  matchRecords MatchRecord[]
  goals        Goal[]
  trainingRecords TrainingSessionRecord[]
  documents    Document[]

  @@index([batchId, status])
  @@index([coachId])
  @@index([fullName])
  @@index([mobile])
  @@index([createdAt])
}

model CoachProfile {
  id             String   @id @default(cuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id])
  specialization String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model StudentParent {
  id        String   @id @default(cuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id])
  parentId  String
  parent    User     @relation(fields: [parentId], references: [id])
  createdAt DateTime @default(now())

  @@unique([studentId, parentId])
  @@index([parentId])
}

model Attendance {
  id        String           @id @default(cuid())
  studentId String
  student   Student          @relation(fields: [studentId], references: [id])
  date      DateTime         @db.Date
  status    AttendanceStatus
  markedBy  String
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@unique([studentId, date])
  @@index([date, status])
  @@index([studentId, date])
}

model Fee {
  id            String        @id @default(cuid())
  studentId     String
  student       Student       @relation(fields: [studentId], references: [id])
  month         String
  monthlyFee    Int
  discount      Int           @default(0)
  paidAmount    Int           @default(0)
  balance       Int
  dueDate       DateTime      @db.Date
  paymentDate   DateTime?     @db.Date
  paymentMethod PaymentMethod?
  receiptNumber String?       @unique
  status        FeeStatus     @default(PENDING)
  remarks       String?
  waivedBy      String?
  createdBy     String
  updatedBy     String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@unique([studentId, month])
  @@index([month, status])
  @@index([dueDate])
  @@index([status])
}

model Performance {
  id               String   @id @default(cuid())
  studentId        String
  student          Student  @relation(fields: [studentId], references: [id])
  date             DateTime @default(now()) @db.Date
  battingRating    Int
  bowlingRating    Int
  fieldingRating   Int
  fitnessRating    Int
  disciplineRating Int
  overallRating    Float
  subSkills        Json?
  remarks          String?
  coachId          String?
  coach            User?    @relation(fields: [coachId], references: [id])
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([studentId, date])
}

model Goal {
  id          String     @id @default(cuid())
  studentId   String
  student     Student    @relation(fields: [studentId], references: [id])
  coachId     String?
  coach       User?      @relation(fields: [coachId], references: [id])
  title       String
  description String?
  category    String?
  baseline    String?
  target      String?
  progress    Int        @default(0)
  status      GoalStatus @default(NOT_STARTED)
  deadline    DateTime?  @db.Date
  createdBy   String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  updates GoalUpdate[]

  @@index([studentId, status])
  @@index([coachId])
  @@index([status])
}

model GoalUpdate {
  id        String   @id @default(cuid())
  goalId    String
  goal      Goal     @relation(fields: [goalId], references: [id])
  progress  Int
  note      String?
  createdBy String
  createdAt DateTime @default(now())

  @@index([goalId])
}

model TrainingSession {
  id        String           @id @default(cuid())
  date      DateTime         @db.Date
  batchId   String?
  batch     Batch?           @relation(fields: [batchId], references: [id])
  coachId   String?
  coach     User?            @relation(fields: [coachId], references: [id])
  topic     String
  category  TrainingCategory @default(BATTING)
  startTime String?
  endTime   String?
  location  String?
  notes     String?
  createdBy String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  records TrainingSessionRecord[]

  @@index([date])
  @@index([batchId])
  @@index([coachId])
}

model TrainingSessionRecord {
  id         String          @id @default(cuid())
  sessionId  String
  session    TrainingSession @relation(fields: [sessionId], references: [id])
  studentId  String
  student    Student         @relation(fields: [studentId], references: [id])
  present    Boolean         @default(true)
  notes      String?
  highlights String?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@unique([sessionId, studentId])
  @@index([studentId])
}

model Admission {
  id               String          @id @default(cuid())
  studentName      String
  dob              DateTime        @db.Date
  gender           Gender
  guardianName     String
  phone            String
  email            String?
  preferredBatchId String?
  preferredBatch   Batch?          @relation(fields: [preferredBatchId], references: [id])
  experience       String?
  playingRole      String?
  message          String?
  status           AdmissionStatus @default(NEW)
  reviewedBy       String?
  reviewedAt       DateTime?
  studentId        String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([preferredBatchId])
}

model Match {
  id          String       @id @default(cuid())
  matchDate   DateTime     @db.Date
  opponent    String
  venue       String?
  matchType   MatchType?
  competition String?
  tossWon     Boolean?
  overs       Int?
  notes       String?
  result      MatchResult?
  coachId     String?
  coach       User?        @relation(fields: [coachId], references: [id])
  records     MatchRecord[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  createdBy   String?

  @@index([matchDate])
}

model MatchRecord {
  id              String     @id @default(cuid())
  matchId         String
  match           Match      @relation(fields: [matchId], references: [id])
  studentId       String
  student         Student    @relation(fields: [studentId], references: [id])
  selected        Boolean    @default(true)
  battingPosition Int?
  runs            Int        @default(0)
  ballsFaced      Int?
  fours           Int        @default(0)
  sixes           Int        @default(0)
  dismissal       Dismissal?
  wickets         Int        @default(0)
  oversBowled     Float?
  maidens         Int        @default(0)
  runsConceded    Int?
  catches         Int        @default(0)
  runOuts         Int        @default(0)
  stumpings       Int        @default(0)
  strikeRate      Float?
  economy         Float?
  manOfTheMatch   Boolean    @default(false)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@unique([matchId, studentId])
  @@index([studentId])
}

model Expense {
  id            String        @id @default(cuid())
  title         String
  category      ExpenseCategory
  amount        Int
  date          DateTime      @db.Date
  paymentMethod PaymentMethod?
  notes         String?
  createdBy     String
  updatedBy     String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([date, category])
  @@index([category])
}

model Package {
  id              String      @id @default(cuid())
  name            String
  description     String?
  price           Int
  billingType     BillingType @default(MONTHLY)
  sessionsPerWeek Int         @default(0)
  features        String[]
  startDate       DateTime?   @db.Date
  endDate         DateTime?   @db.Date
  isActive        Boolean     @default(true)
  createdBy       String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([isActive])
}

model Document {
  id         String   @id @default(cuid())
  studentId  String
  student    Student  @relation(fields: [studentId], references: [id])
  title      String
  type       String?
  url        String
  uploadedBy String
  uploader   User     @relation("DocumentUploader", fields: [uploadedBy], references: [id])
  createdAt  DateTime @default(now())

  @@index([studentId])
  @@index([uploadedBy])
}

model Activity {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id])
  type      ActivityType
  action    String
  entity    String?
  entityId  String?
  details   String?
  createdAt DateTime     @default(now())

  @@index([createdAt])
  @@index([userId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  role      Role?
  title     String
  body      String
  type      String   @default("info")
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
  @@index([role])
}

model Announcement {
  id        String              @id @default(cuid())
  title     String
  body      String
  audience  String              @default("ALL")
  priority  AnnouncementPriority @default(MEDIUM)
  batchId   String?
  batch     Batch?              @relation(fields: [batchId], references: [id])
  createdBy String
  createdAt DateTime            @default(now())

  @@index([createdAt])
  @@index([batchId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedBy String?
  updatedAt DateTime @updatedAt
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  endpoint  String   @unique
  keys      Json?
  createdAt DateTime @default(now())

  @@index([userId])
}

model OfflineSyncRecord {
  id        String   @id @default(cuid())
  key       String   @unique
  createdAt DateTime @default(now())

  @@index([createdAt])
}